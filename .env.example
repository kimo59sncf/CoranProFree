# ============================================================================
# CoranProFree — Environment example
# ============================================================================
# Copy this file to `.env` (or export the values in your shell) as needed.
# NEVER commit real secrets to the repository.
# ============================================================================

# --- API server (artifacts/api-server) ---
# PostgreSQL connection string. Required only if you run the API server locally.
DATABASE_URL=postgresql://user:password@localhost:5432/coranprofree

# Port the API server listens on.
PORT=5000

# Log level for the API server (trace | debug | info | warn | error).
LOG_LEVEL=info

# --- Expo app (artifacts/quran-pro-audio) ---
# Public domain used by the static build script (scripts/build.js).
# Falls back to localhost:8081 when unset.
EXPO_PUBLIC_DOMAIN=localhost:8081
